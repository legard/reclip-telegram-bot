# Telegram Bot Configuration
BOT_TOKEN=your-bot-token-from-botfather
# Required: comma-separated Telegram user IDs permitted to use the private bot.
# The bot refuses to start when this value is missing or invalid.
ALLOWED_USER_IDS=123,456
# Separate SQLite database for durable bot preferences. Docker persists this
# path in the bot-data volume, so preferences survive bot container restarts.
BOT_DB_PATH=/data/bot.db

# Telegram Bot API Server (self-hosted for 2GB upload limit)
# Get these from https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash

# Reclip Configuration
RECLIP_URL=http://reclip:8899
RECLIP_HOST=0.0.0.0
RECLIP_PORT=8899
MAX_CONCURRENT_DOWNLOADS=3
# Shared ReClip job deadline in seconds (150 minutes). It takes precedence
# over the legacy DOWNLOAD_TIMEOUT fallback used by existing deployments.
JOB_TIMEOUT=9000

# Cleanup Configuration
CLEANUP_MAX_AGE_HOURS=1
# 0 disables size cleanup; age cleanup remains active.
CLEANUP_MAX_DISK_MB=0
CLEANUP_INTERVAL_SECONDS=300

# Shared downloads directory (Docker volume)
DOWNLOADS_PATH=/downloads

# Dashboard Configuration
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=your-dashboard-password
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=change-me-to-a-random-string
